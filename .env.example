# ===================================================
# VIKA Academic Chatbot - Environment Configuration
# ===================================================

# Google Gemini API Key (Dapatkan gratis di https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Key (Dapatkan gratis di https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here

# Model Gemini yang Digunakan
GEMINI_MODEL=gemini-3.8-flash

# AI Generation Hyperparameters (Anti-Hallucination & Sampling Control)
LLM_TEMPERATURE=0.2
LLM_TOP_P=0.90
LLM_TOP_K=40
LLM_MAX_OUTPUT_TOKENS=2048

# Developer Admin PIN Gate (PIN pengaman menu pengaturan API)
ADMIN_PIN=2026

# Hybrid Vector Embedding & Cosine Similarity (Hacktiv8 Session 2)
EMBEDDING_MODEL=text-embedding-004
HYBRID_ALPHA=0.55

# Pengaturan Server Aplikasi
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

